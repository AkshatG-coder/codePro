# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://syncboard:syncboard_secret@localhost:5432/syncboard"

# ── NextAuth ──────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_32_CHAR_RANDOM_STRING"

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Judge0 ────────────────────────────────────────────────────────
# LOCAL (Docker Compose / K8s):  set to http://localhost:2358, leave RAPIDAPI_KEY empty
# CLOUD (free RapidAPI tier):    set URL to https://judge0-ce.p.rapidapi.com, fill RAPIDAPI_KEY
JUDGE0_API_URL="http://localhost:2358"
RAPIDAPI_KEY=""

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
