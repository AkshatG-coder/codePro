# ─── CodePro Docker Environment Variables ───────────────────────
# Copy this file to .env on your Azure VM and fill in the values.
# Used by docker-compose.prod.yml via `env_file: .env`

# ─── Database (Neon - primary app database) ──────────────────────
DATABASE_URL=

# ─── NextAuth.js ─────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=https://codepro.akshatg.codes
AUTH_TRUST_HOST=true

# ─── Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Judge0 ──────────────────────────────────────────────────────
# This is set automatically in docker-compose.prod.yml
# JUDGE0_API_URL=http://judge0-server:2358
JUDGE0_CALLBACK_SECRET=

# ─── App URLs ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://codepro.akshatg.codes
FRONTEND_URL=https://codepro.akshatg.codes

# ─── API Secrets ─────────────────────────────────────────────────
JWT_SECRET=
